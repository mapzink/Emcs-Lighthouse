<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>The Lighthouse — School Blog</title>
  <link rel="icon" type="image/x-icon" href="/images/lighthouse-logo.png">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,500;1,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/emoji.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
  <style>
    :root {
      --accent: #f47d42;
      --bg-gradient: radial-gradient(circle at top, #0b0f22 0%, #04050e 100%);
      --text: #f4f3f0;
      --muted: #cad0dd;
      --radius: 18px;
      --surface: rgba(9, 12, 24, 0.56);
      --border: rgba(255, 255, 255, 0.15);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Manrope', 'Apple Color Emoji Web', 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
      color: var(--text);
      width: 100%;
      min-height: 100%;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      background: var(--bg-gradient);
      background-size: cover;
      background-position: center;
    }

    /* ---------------- HEADER ---------------- */
    header {
      width: 100%;
      padding: 20px clamp(18px, 6vw, 60px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(7, 10, 21, 0.54);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(10px);
      position: fixed;
      top: 0;
      z-index: 1000;
    }

    header img {
      height: clamp(56px, 7vw, 80px);
      width: auto;
      object-fit: cover;
      object-position: top;
      border-radius: var(--radius);
      cursor: pointer;
    }

    nav {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 8px;
    }

    nav a {
      text-decoration: none;
      color: var(--text);
      font-weight: 600;
      font-size: 1rem;
      padding: 8px 10px;
      transition: 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border-radius: 10px;
    }

    nav a:hover {
      color: #fff5e8;
      text-shadow: 0 0 12px rgba(244, 125, 66, 0.75);
      background: rgba(255, 255, 255, 0.06);
    }

    /* ---------------- HERO ---------------- */
    .hero {
      width: 100%;
      min-height: 100vh;
      max-width: none;
      margin: 0;
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      justify-content: flex-start;
      padding: clamp(170px, 26vh, 240px) clamp(20px, 7vw, 92px) clamp(72px, 12vh, 140px);
      text-align: left;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url('/images/index_img.gif?v=2') center center / cover no-repeat;
      transform: scaleX(-1) scale(1.08);
      filter: brightness(0.55) contrast(1.15) saturate(0.92);
      z-index: -3;
    }

    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 72% 18%, rgba(244, 125, 66, 0.34) 0%, rgba(244, 125, 66, 0.08) 22%, rgba(0, 0, 0, 0) 45%),
        linear-gradient(112deg, rgba(3, 7, 18, 0.9) 0%, rgba(3, 7, 18, 0.62) 44%, rgba(3, 7, 18, 0.25) 72%),
        linear-gradient(0deg, rgba(3, 7, 18, 0.88) 0%, rgba(3, 7, 18, 0.08) 52%, rgba(3, 7, 18, 0.25) 100%);
      z-index: -2;
    }

    .hero-content {
      max-width: min(780px, 100%);
      position: relative;
      z-index: 1;
    }

    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 0.84rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #e8d8ca;
      margin-bottom: 22px;
      transform: translateY(-185px);
    }

    .hero-kicker::before {
      content: '';
      width: 42px;
      height: 1px;
      background: rgba(244, 125, 66, 0.85);
    }

    .hero h1 {
      font-family: 'Cormorant Garamond', 'Noto Serif', serif;
      font-size: clamp(3.1rem, 10vw, 7.25rem);
      font-weight: 600;
      letter-spacing: -0.018em;
      line-height: 0.88;
      color: #f7f5f0;
      margin-bottom: 22px;
      text-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
    }

    .hero h1 .line-ital {
      display: block;
      font-style: italic;
      font-weight: 500;
    }

    .hero h1 .line-accent {
      display: block;
      color: var(--accent);
    }

    .hero .motto {
      margin-bottom: 26px;
      font-family: 'Cormorant Garamond', 'Noto Serif', serif;
      font-size: clamp(1.28rem, 2.9vw, 2.05rem);
      font-style: italic;
      color: #ffdfc4;
      letter-spacing: 0.01em;
    }

    .hero .subcopy {
      font-size: clamp(1rem, 1.8vw, 1.2rem);
      color: #d7dcec;
      max-width: 620px;
      line-height: 1.62;
      margin-bottom: 48px;
    }

    .hero-links {
      display: flex;
      gap: 22px;
      flex-wrap: wrap;
    }

    .hero-links a {
      text-decoration: none;
      color: #fff2e3;
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 999px;
      font-size: 0.9rem;
      font-weight: 600;
      padding: 10px 16px;
      transition: 0.25s ease;
    }

    .hero-links a:hover {
      border-color: rgba(244, 125, 66, 0.8);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
      background: rgba(244, 125, 66, 0.2);
      transform: translateY(-2px);
    }

    .light-beam {
      position: fixed;
      width: 420px;
      height: 420px;
      top: 0;
      left: 0;
      pointer-events: none;
      z-index: 2147483640;
      opacity: 0.12;
      transition: opacity 0.25s ease;
      background: radial-gradient(circle, rgba(255, 245, 220, 0.22) 0%, rgba(255, 245, 220, 0.1) 28%, rgba(255, 245, 220, 0) 64%);
      filter: blur(24px);
      transform: translate(-50%, -50%);
      mix-blend-mode: screen;
      will-change: opacity, left, top;
    }

    /* ---------------- CAROUSEL INFINITE PERSPECTIVE ---------------- */
    .carousel-section {
      padding: 120px 20px 80px;
      max-width: 100%;
      margin: 0 auto;
    }

    .carousel-container {
      position: relative;
      width: 100%;
      height: 600px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: visible;
    }

    .carousel-viewport {
      position: relative;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .carousel-track {
      width: 100%;
      height: 100%;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .carousel-track.paused {
      animation-play-state: paused;
    }

    .carousel-item {
      position: absolute;
      width: 260px;
      height: 420px;
      border-radius: 16px;
      overflow: hidden;
      transform-origin: center center;
      cursor: pointer;
      will-change: transform, opacity;
      display: flex;
      flex-direction: column;
    }

    .carousel-item.active {
      z-index: 10;
    }

    .carousel-item-color {
      height: 68%;
      width: 100%;
      background: linear-gradient(135deg, var(--accent) 0%, rgba(244, 125, 66, 0.7) 100%);
      position: relative;
      overflow: hidden;
      display: block;
      flex-shrink: 0;
      border-radius: 0;
    }

    .carousel-item-color.alt1 {
      background: linear-gradient(135deg, #2f4a5a 0%, #1f3340 100%);
    }

    .carousel-item-color.alt2 {
      background: linear-gradient(135deg, #3d5a6a 0%, #2a3f52 100%);
    }

    .carousel-item-color.alt3 {
      background: linear-gradient(135deg, #4a5f7f 0%, #35485a 100%);
    }

    .carousel-item-color.alt4 {
      background: linear-gradient(135deg, var(--accent) 0%, rgba(244, 125, 66, 0.7) 100%);
    }

    .carousel-item-color.alt5 {
      background: linear-gradient(135deg, #2f4a5a 0%, #1f3340 100%);
    }

    .carousel-item-color.alt6 {
      background: linear-gradient(135deg, #3d5a6a 0%, #2a3f52 100%);
    }

    .carousel-item-content {
      height: 32%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      background: rgba(15, 20, 35, 0.5);
    }

    .carousel-item-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.2;
    }

    .carousel-item-subtitle {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.4;
    }

    .carousel-controls {
      display: flex;
      justify-content: center;
      gap: 28px;
      margin-top: 60px;
      position: relative;
      z-index: 10;
      max-width: 1400px;
      margin-left: auto;
      margin-right: auto;
      padding: 0 20px;
    }

    .carousel-btn {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--surface);
      border: 2px solid var(--border);
      color: var(--accent);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      will-change: transform, background, border-color;
    }

    .carousel-btn:hover {
      border-color: var(--accent);
      background: rgba(244, 125, 66, 0.15);
      transform: scale(1.08);
      box-shadow: 0 8px 24px rgba(244, 125, 66, 0.25);
    }

    .carousel-btn:active {
      transform: scale(0.95);
    }

    /* Respect prefers-reduced-motion */
    @media (prefers-reduced-motion: reduce) {
      .carousel-btn {
        transition: none !important;
      }
    }

    /* Responsive carousel */
    @media (max-width: 1024px) {
      .carousel-section {
        padding: 100px 20px 60px;
      }

      .carousel-container {
        height: 520px;
      }

      .carousel-item {
        width: 260px;
        height: 440px;
      }
    }

    @media (max-width: 768px) {
      .carousel-section {
        padding: 80px 16px 50px;
      }

      .carousel-container {
        height: 450px;
      }

      .carousel-item {
        width: 240px;
        height: 400px;
      }

      .carousel-item-color {
        flex: 0 0 65%;
      }

      .carousel-item-content {
        padding: 18px 16px;
      }

      .carousel-item-title {
        font-size: 1.1rem;
      }

      .carousel-item-subtitle {
        font-size: 0.8rem;
      }

      .carousel-btn {
        width: 48px;
        height: 48px;
        font-size: 1rem;
      }
    }

    @media (max-width: 480px) {
      .carousel-section {
        padding: 60px 12px 40px;
      }

      .carousel-container {
        height: 380px;
      }

      .carousel-item {
        width: 200px;
        height: 340px;
      }

      .carousel-item-content {
        padding: 16px 12px;
        gap: 6px;
      }

      .carousel-item-title {
        font-size: 0.95rem;
      }

      .carousel-item-subtitle {
        font-size: 0.75rem;
      }

      .carousel-btn {
        width: 44px;
        height: 44px;
        font-size: 0.9rem;
      }
    }

    /* ---------------- SECTION LAYOUTS ---------------- */
    section:not(.hero) {
      padding: 100px 20px;
      max-width: 1100px;
      margin: 0 auto;
      text-align: center;
    }

    section:not(.hero) h2 {
      font-family: 'Cormorant Garamond', 'Noto Serif', serif;
      font-size: clamp(2.2rem, 5vw, 2.9rem);
      margin-bottom: 20px;
      color: #fff;
    }

    section:not(.hero) p {
      font-size: 1.1rem;
      color: var(--muted);
      max-width: 700px;
      margin: 0 auto 40px;
      line-height: 1.7;
    }

    /* ---------------- FOOTER ---------------- */
    footer {
      padding: 40px 20px;
      text-align: center;
      color: var(--muted);
      background: rgba(8, 10, 19, 0.72);
    }

    footer a {
      color: var(--accent);
      text-decoration: none;
    }

    footer a:hover {
      color: #ffba8f;
      text-decoration: none;
      text-shadow: 0 0 8px rgba(244, 125, 66, 0.8);
      transition: 0.3s ease;
    }

    @media (max-width: 900px) {
      header {
        gap: 8px;
      }

      nav a {
        font-size: 0.92rem;
        padding: 7px 9px;
      }
    }

    @media (max-width: 700px) {
      header {
        padding-inline: 14px;
      }

      nav {
        gap: 2px;
      }

      nav a {
        font-size: 0.84rem;
        gap: 6px;
      }

      .hero {
        padding: 150px 16px 68px;
      }

      .hero::before {
        transform: scaleX(-1) scale(1.18);
      }

      .hero h1 {
        line-height: 0.9;
      }

      .hero .motto {
        margin-bottom: 18px;
      }

      .hero .subcopy {
        line-height: 1.5;
        margin-bottom: 32px;
      }
    }
  </style>
</head>
<body>
  <!-- Header with navigation links and icons -->
  <header>
    <img src="/images/lighthouse-logo.png" alt="The Lighthouse Logo" onclick="window.location.href='/'">
    <nav>
      <a href="/articles"><i class="fa-solid fa-file-lines"></i> Articles</a>
      <a href="/blog"><i class="fa-solid fa-newspaper"></i> Blog</a>
      <a href="/podcasts"><i class="fa-solid fa-podcast"></i> Podcasts</a>
      <a href="/help"><i class="fa-solid fa-circle-question"></i> Help</a>
      <a href="/login"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
    </nav>
  </header>

  <div class="light-beam" id="lightBeam"></div>
  <section class="hero">
    <div class="hero-content">
      <p class="hero-kicker">A EMCS Student Platform</p>
      <h1>
        We publish
        <span class="line-ital">from the halls,</span>
        <span class="line-accent">for the family.</span>
      </h1>
      <p class="motto">"Lighthouse — Let There be Light!"</p>
      <p class="subcopy">Student stories, school updates, honest opinions, and creative voices in one place. The Lighthouse helps our community stay informed, inspired, and connected.</p>
      <div class="hero-links">
        <a href="/articles">Read Articles</a>
        <a href="/podcasts">Listen to Podcasts</a>
      </div>
    </div>
  </section>

  <!-- Carousel Section -->
  <section class="carousel-section">
    <div class="carousel-container" id="carouselContainer">
      <div class="carousel-viewport">
        <div class="carousel-track" id="carouselTrack">
          <div class="carousel-item">
            <div class="carousel-item-color"></div>
            <div class="carousel-item-content">
              <h3 class="carousel-item-title">Featured Story</h3>
              <p class="carousel-item-subtitle">Discover what's happening</p>
            </div>
          </div>
          <div class="carousel-item">
            <div class="carousel-item-color alt1"></div>
            <div class="carousel-item-content">
              <h3 class="carousel-item-title">Latest Updates</h3>
              <p class="carousel-item-subtitle">Stay informed</p>
            </div>
          </div>
          <div class="carousel-item">
            <div class="carousel-item-color alt2"></div>
            <div class="carousel-item-content">
              <h3 class="carousel-item-title">Creative Voices</h3>
              <p class="carousel-item-subtitle">Student work showcase</p>
            </div>
          </div>
          <div class="carousel-item">
            <div class="carousel-item-color alt3"></div>
            <div class="carousel-item-content">
              <h3 class="carousel-item-title">Community Highlights</h3>
              <p class="carousel-item-subtitle">Join the conversation</p>
            </div>
          </div>
          <div class="carousel-item">
            <div class="carousel-item-color alt4"></div>
            <div class="carousel-item-content">
              <h3 class="carousel-item-title">Student Voices</h3>
              <p class="carousel-item-subtitle">Hear from peers</p>
            </div>
          </div>
          <div class="carousel-item">
            <div class="carousel-item-color alt5"></div>
            <div class="carousel-item-content">
              <h3 class="carousel-item-title">Archives</h3>
              <p class="carousel-item-subtitle">Look back in time</p>
            </div>
          </div>
          <div class="carousel-item">
            <div class="carousel-item-color alt6"></div>
            <div class="carousel-item-content">
              <h3 class="carousel-item-title">Announcements</h3>
              <p class="carousel-item-subtitle">Important updates</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="carousel-controls">
      <button class="carousel-btn carousel-btn-prev" id="carouselPrev" aria-label="Previous slide">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button class="carousel-btn carousel-btn-next" id="carouselNext" aria-label="Next slide">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </section>

  <!-- Page sections -->
  <section>
    <h2>About Us</h2>
    <p>The Lighthouse is a school blog created by students for students. We bring together news, guides, and creative work to inspire and inform our community.</p>
  </section>

  <section>
    <h2>Highlights</h2>
    <p>Check out our featured posts, project showcases, and inspiring voices from across the school.</p>
  </section>

  <section>
    <h2>Join the Team</h2>
    <p>Want to write, edit, or design for The Lighthouse? We&#x2019;re always looking for passionate contributors. Let your creativity guide others.</p>
  </section>

  <!-- Footer with EMCS link and contact -->
  <footer>
    <p><a href="/contact">Contact</a> | <a href="https://emmanuelcs.ca/" target="_blank">EMCS Website</a></p>
    <p>&copy; <span id="year"></span> The Lighthouse — Built by students, for students.</p>
  </footer>

  <script>
    // Update the year automatically
    document.getElementById('year').textContent = new Date().getFullYear();

    // Subtle moving light effect across the entire viewport
    const lightBeam = document.getElementById('lightBeam');

    function updateLightPosition(event) {
      if (!lightBeam) return;
      const x = event.clientX;
      const y = event.clientY;
      lightBeam.style.left = `${x}px`;
      lightBeam.style.top = `${y}px`;
      lightBeam.style.opacity = '0.14';
    }

    function fadeLightOut() {
      if (!lightBeam) return;
      lightBeam.style.opacity = '0.08';
    }

    window.addEventListener('mousemove', updateLightPosition);
    window.addEventListener('mouseleave', fadeLightOut);
    window.addEventListener('mouseout', fadeLightOut);

    // Infinite perspective carousel with dramatic depth
    const carouselContainer = document.getElementById('carouselContainer');
    const carouselTrack = document.getElementById('carouselTrack');
    const carouselItems = carouselTrack.querySelectorAll('.carousel-item');
    const prevBtn = document.getElementById('carouselPrev');
    const nextBtn = document.getElementById('carouselNext');

    const CARD_COUNT = carouselItems.length;
    const AUTO_SCROLL_INTERVAL = 3500; // 3.5 seconds between auto-scroll
    const ANIMATION_DURATION = 600; // 600ms smooth easing
    const RESUME_DELAY = 1000; // 1 second before resuming auto-scroll

    let currentIndex = 0;
    let autoScrollInterval = null;
    let resumeTimeout = null;
    let isPaused = false;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const positions = [
      { translateX: -460, translateY: 60,  rotateY:  75, scale: 0.52, opacity: 0.20 }, // -3
      { translateX: -290, translateY: 35,  rotateY:  55, scale: 0.68, opacity: 0.42 }, // -2
      { translateX: -150, translateY: 15,  rotateY:  32, scale: 0.84, opacity: 0.68 }, // -1
      { translateX:    0, translateY:  0,  rotateY:   0, scale: 1.00, opacity: 1.00 }, // centre
      { translateX:  150, translateY: 15,  rotateY: -32, scale: 0.84, opacity: 0.68 }, // +1
      { translateX:  290, translateY: 35,  rotateY: -55, scale: 0.68, opacity: 0.42 }, // +2
      { translateX:  460, translateY: 60,  rotateY: -75, scale: 0.52, opacity: 0.20 }, // +3
    ];

    function updateCarousel() {
      const total = carouselItems.length;
      carouselItems.forEach((card, i) => {
        const offset = ((i - currentIndex) % total + total) % total;
        const pos = offset <= 3
          ? positions[3 + offset]
          : positions[3 - (total - offset)];
        if (!pos) { card.style.opacity = 0; return; }

        anime({
          targets: card,
          translateX: pos.translateX,
          translateY: pos.translateY,
          rotateY: pos.rotateY + 'deg',
          scale: pos.scale,
          opacity: pos.opacity,
          duration: 700,
          easing: 'easeInOutQuart'
        });
        
        card.style.zIndex = Math.round(pos.scale * 10);
      });
    }

    function startAutoScroll() {
      if (prefersReducedMotion) return;
      autoScrollInterval = setInterval(() => {
        currentIndex = (currentIndex + 1) % carouselItems.length;
        updateCarousel();
      }, AUTO_SCROLL_INTERVAL);
    }

    function stopAutoScroll() {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
      }
    }

    function stopResumeTimeout() {
      if (resumeTimeout) {
        clearTimeout(resumeTimeout);
        resumeTimeout = null;
      }
    }

    function goToNext() {
      stopAutoScroll();
      stopResumeTimeout();
      currentIndex = (currentIndex + 1) % carouselItems.length;
      updateCarousel();
      
      isPaused = true;
      resumeTimeout = setTimeout(() => {
        isPaused = false;
        startAutoScroll();
      }, RESUME_DELAY);
    }

    function goToPrev() {
      stopAutoScroll();
      stopResumeTimeout();
      currentIndex = (currentIndex - 1 + carouselItems.length) % carouselItems.length;
      updateCarousel();
      
      isPaused = true;
      resumeTimeout = setTimeout(() => {
        isPaused = false;
        startAutoScroll();
      }, RESUME_DELAY);
    }

    // Pause on hover (carousel or buttons)
    [carouselContainer, prevBtn, nextBtn].forEach(el => {
      el.addEventListener('mouseenter', () => {
        stopAutoScroll();
        stopResumeTimeout();
        isPaused = true;
      });

      el.addEventListener('mouseleave', () => {
        if (!isPaused) {
          stopResumeTimeout();
          resumeTimeout = setTimeout(() => {
            startAutoScroll();
          }, RESUME_DELAY);
        }
      });
    });

    prevBtn.addEventListener('click', goToPrev);
    nextBtn.addEventListener('click', goToNext);

    // Initialize carousel
    updateCarousel();
    if (!prefersReducedMotion) {
      startAutoScroll();
    }

    // Cleanup
    window.addEventListener('beforeunload', stopAutoScroll);
  </script>
</body>
</html>
