<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>The Lighthouse — Blog</title>
  <link rel="icon" type="image/x-icon" href="/images/lighthouse-logo.png">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/emoji.css">
  <link rel="stylesheet" href="/css/site-header.css">

  <style>
    :root {
      --accent: #ff4b2b;
      --bg-gradient: radial-gradient(circle at top, #0a0e27 0%, #020411 100%);
      --text: #f0f3ff;
      --muted: #9ba1c2;
      --radius: 18px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Noto Serif', 'Apple Color Emoji Web', 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', serif;
      color: var(--text);
      min-height: 100vh;
      background: var(--bg-gradient);
      overflow-x: hidden;
      position: relative;
    }

    /* ---------------- HEADER (MATCHES INDEX) ---------------- */
    header {
      width: 100%;
      padding: 24px 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(10, 14, 39, 0.5);
      backdrop-filter: blur(10px);
      position: fixed;
      top: 0;
      z-index: 1000;
    }

    header img {
      height: 80px;
      border-radius: var(--radius);
      cursor: pointer;
    }

    nav a {
      text-decoration: none;
      color: var(--text);
      font-weight: 600;
      font-size: 1.05rem;
      margin: 0 20px;
      transition: 0.3s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    nav a:hover {
      color: var(--accent);
      text-shadow: 0 0 8px var(--accent);
    }

    .blog-page { max-width: 1180px; margin: 0 auto; padding: 150px 24px 72px; position: relative; z-index: 1; }
    .blog-hero { text-align: center; margin-bottom: 42px; }
    .blog-hero h1 { font-size: clamp(2.5rem, 6vw, 4rem); background: linear-gradient(90deg, #ff7e5f, #feb47b); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .blog-hero p { max-width: 650px; margin: 14px auto 0; color: var(--muted); line-height: 1.7; }
    .blog-grid { display: grid; grid-template-columns: minmax(0, 820px); justify-content: center; gap: 22px; }
    .blog-card { overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: var(--radius); background: rgba(255,255,255,.06); box-shadow: 0 18px 46px rgba(0,0,0,.25); transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
    .blog-card:hover { transform: translateY(-5px); border-color: rgba(255,126,95,.75); box-shadow: 0 22px 52px rgba(255,75,43,.16); }
    .blog-card__cover { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-bottom: 1px solid rgba(255,255,255,.1); }
    .blog-card__body { padding: 22px; }
    .blog-card h2 { font-size: 1.3rem; line-height: 1.3; margin-bottom: 10px; }
    .blog-card h2 a { color: var(--text); text-decoration: none; }
    .blog-card h2 a:hover { color: #ffb18f; }
    .blog-card p { color: var(--muted); line-height: 1.6; }
    .blog-card__meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; color: var(--muted); font-size: .85rem; }
    .blog-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; }
    .blog-tag { padding: 4px 9px; border-radius: 999px; color: #ffd1c2; background: rgba(255,75,43,.14); font-size: .75rem; }
    .blog-empty { padding: 42px 24px; border: 1px dashed rgba(255,255,255,.2); border-radius: var(--radius); color: var(--muted); text-align: center; }

    /* ---------------- WIP HERO ---------------- */
    .wip {
      min-height: 100vh;
      display: grid;
      place-items: center;
      text-align: center;
      padding-top: 120px; /* header offset */
    }

    .card {
      max-width: 560px;
      margin: 20px;
      padding: 48px 44px;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(12px);
      border-radius: var(--radius);
      box-shadow: 0 20px 50px rgba(0,0,0,0.45);
    }

    .card h1 {
      font-size: 2.6rem;
      margin-bottom: 14px;
      background: linear-gradient(90deg, #ff7e5f, #feb47b);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .card p {
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 20px;
    }

    .status {
      display: inline-block;
      margin-top: 10px;
      padding: 8px 18px;
      border-radius: 999px;
      font-size: 0.75rem;
      letter-spacing: 1px;
      font-weight: 700;
      color: var(--accent);
      border: 1px solid rgba(255,255,255,0.15);
      background: rgba(255,255,255,0.04);
    }

    .back-btn {
      display: inline-block;
      margin-top: 32px;
      padding: 12px 30px;
      border-radius: 30px;
      background: linear-gradient(90deg, #ff4b2b, #ff416c);
      color: #fff;
      font-weight: 600;
      text-decoration: none;
      transition: 0.3s ease;
    }

    .back-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0 12px var(--accent);
    }

    /* ---------------- FOOTER ---------------- */
    footer {
      text-align: center;
      padding: 30px 20px;
      color: var(--muted);
      background: rgba(10, 14, 39, 0.6);
    }

    footer a {
      color: var(--accent);
      text-decoration: none;
    }

    footer a:hover {
      text-shadow: 0 0 8px var(--accent);
    }
  
    /* ---------------- STARS (FROM INDEX) ---------------- */
    .stars {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;
    }

    .star {
      position: absolute;
      width: 2px;
      height: 2px;
      background: white;
      border-radius: 50%;
      animation: twinkle 4s infinite ease-in-out;
      opacity: 0.6;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0.25; }
      50% { opacity: 1; }
    }

  </style>
</head>
<body>

  <%- include('_header') %>

  <div class="stars" id="stars"></div>
  <% if (blogComingSoon) { %>
  <main class="wip">
    <div class="card">
      <h1>Blog coming soon</h1>
      <p>The Lighthouse Blog is being prepared for publication.</p>
      <p>Check back soon for stories, ideas, and student perspectives.</p>
      <span class="status">COMING SOON</span>
      <br>
      <a class="back-btn" href="/">Return to Home</a>
    </div>
  </main>
  <% } else { %>
  <main class="blog-page">
    <section class="blog-hero">
      <h1>The Lighthouse Blog</h1>
      <p>Fresh stories, ideas, and perspectives from the EMCS community.</p>
    </section>
    <% if (!articles.length) { %>
      <div class="blog-empty">No published articles yet. Check back soon.</div>
    <% } else { %>
      <section id="blogGrid" class="blog-grid" aria-label="Published articles">
        <% articles.forEach(article => { %>
          <article class="blog-card">
            <a href="/blog/articles/<%= encodeURIComponent(article.blogNumber) %>"><img class="blog-card__cover" src="<%= article.coverImagePath %>" alt="" loading="lazy"></a>
            <div class="blog-card__body">
              <h2><a href="/blog/articles/<%= encodeURIComponent(article.blogNumber) %>"><%= article.title %></a></h2>
              <p><%= article.snippet || 'Read the latest story from The Lighthouse.' %></p>
              <% if (article.tags.length) { %><div class="blog-tags"><% article.tags.slice(0, 4).forEach(tag => { %><span class="blog-tag"><%= tag %></span><% }) %></div><% } %>
              <div class="blog-card__meta"><span><i class="fa-regular fa-calendar"></i> <%= article.publishedLabel %></span><span><i class="fa-regular fa-eye"></i> <%= Number(article.views || 0).toLocaleString() %></span><% if (article.minuteRead) { %><span><i class="fa-regular fa-clock"></i> <%= article.minuteRead %> min read</span><% } %></div>
            </div>
          </article>
        <% }) %>
      </section>
      <div id="blogLoadSentinel" aria-hidden="true" style="height:1px;"></div>
    <% } %>
    <% if (typeof pagination !== 'undefined' && pagination && (pagination.hasPrevious || pagination.hasNext)) { %>
      <nav id="blogPagination" aria-label="Blog pages" style="display:flex;justify-content:center;gap:14px;margin-top:30px;">
        <% if (pagination.hasPrevious) { %><a class="back-btn" style="margin-top:0;padding:9px 18px;" href="/blog?page=<%= pagination.page - 1 %>">Newer posts</a><% } %>
        <% if (pagination.hasNext) { %><a class="back-btn" style="margin-top:0;padding:9px 18px;" href="/blog?page=<%= pagination.page + 1 %>">Older posts</a><% } %>
      </nav>
    <% } %>
  </main>
  <% } %>

  <%- include('_footer') %>

  <script>
    // Generate star field dynamically (same logic as index)
    const starContainer = document.getElementById('stars');
    const starFragment = document.createDocumentFragment();
    for (let i = 0; i < 100; i++) {
      const star = document.createElement('div');
      star.classList.add('star');
      star.style.top = Math.random() * 100 + '%';
      star.style.left = Math.random() * 100 + '%';
      star.style.animationDelay = (Math.random() * 5) + 's';
      starFragment.appendChild(star);
    }
    starContainer.appendChild(starFragment);
  </script>

  <% if (!blogComingSoon && articles.length) { %>
  <script>
    (() => {
      const grid = document.getElementById('blogGrid');
      const sentinel = document.getElementById('blogLoadSentinel');
      const fallbackPagination = document.getElementById('blogPagination');
      if (!grid || !sentinel || !fallbackPagination || !('IntersectionObserver' in window)) return;

      let page = <%= pagination.page %>;
      let loading = false;
      let hasNext = <%= pagination.hasNext ? 'true' : 'false' %>;
      fallbackPagination.hidden = true;

      const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
      }[char]));

      const renderCard = article => {
        const tags = Array.isArray(article.tags) ? article.tags.slice(0, 4).map(tag =>
          `<span class="blog-tag">${escapeHtml(tag)}</span>`).join('') : '';
        return `<article class="blog-card">
          <a href="/blog/articles/${encodeURIComponent(article.blogNumber)}"><img class="blog-card__cover" src="${escapeHtml(article.coverImagePath)}" alt="" loading="lazy"></a>
          <div class="blog-card__body">
            <h2><a href="/blog/articles/${encodeURIComponent(article.blogNumber)}">${escapeHtml(article.title)}</a></h2>
            <p>${escapeHtml(article.snippet || 'Read the latest story from The Lighthouse.')}</p>
            ${tags ? `<div class="blog-tags">${tags}</div>` : ''}
            <div class="blog-card__meta">
              <span><i class="fa-regular fa-calendar"></i> ${escapeHtml(article.publishedLabel || 'Recently')}</span>
              <span><i class="fa-regular fa-eye"></i> ${Number(article.views || 0).toLocaleString()}</span>
              ${article.minuteRead ? `<span><i class="fa-regular fa-clock"></i> ${Number(article.minuteRead)} min read</span>` : ''}
            </div>
          </div>
        </article>`;
      };

      const loadNextPage = async () => {
        if (loading || !hasNext) return;
        loading = true;
        try {
          const response = await fetch(`/api/blog?page=${page + 1}&limit=<%= pagination.pageSize %>`, {
            credentials: 'same-origin'
          });
          if (!response.ok) throw new Error(`Blog feed request failed: ${response.status}`);
          const data = await response.json();
          grid.insertAdjacentHTML('beforeend', (data.articles || []).map(renderCard).join(''));
          page = data.page;
          hasNext = Boolean(data.hasNext);
          if (!hasNext) observer.disconnect();
        } catch (error) {
          console.error('Could not load more blog posts:', error);
        } finally {
          loading = false;
        }
      };

      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) loadNextPage();
      }, { rootMargin: '700px 0px' });
      observer.observe(sentinel);
    })();
  </script>
  <% } %>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
